NODE_ENV=development
PORT=5186
WEB_ORIGIN=http://localhost:5185
DATABASE_URL=file:./dev.db
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-3.1-pro-preview
GROQ_API_KEY=replace_me
